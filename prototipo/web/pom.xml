<?xml version="1.0" encoding="UTF-8"?>
<!--
  Prototipo web de FPlus: las pantallas del sistema en su tecnología final (Jakarta Faces + PrimeFaces),
  con datos simulados en memoria. Sin base de datos ni seguridad real: se despliega tal cual en un Payara.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>prototipo</groupId>
    <artifactId>fplus-prototipo-web</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>war</packaging>
    <name>FPlus — prototipo web</name>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>
        <!-- Lo da el servidor (Payara 7, Jakarta EE 11) -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- La misma versión que usará el sistema real: el prototipo se ve igual porque es lo mismo -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces</artifactId>
            <version>16.0.1</version>
        </dependency>
        <!-- Desde PrimeFaces 15 los temas base van aparte (saga-blue viene en el núcleo; arya-blue, aquí) -->
        <dependency>
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces-themes</artifactId>
            <version>16.0.1</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
    </build>
</project>
